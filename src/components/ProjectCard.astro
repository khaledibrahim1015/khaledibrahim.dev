---
interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  slug: string;
  featured?: boolean;
}

const { title, description, date, tags, slug, featured } = Astro.props;
const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="card" data-tags={tags.join(',')}>
  <div class="card-title">
    {featured && <span class="badge-featured">featured</span>}
    <a href={`/projects/${slug}`}>{title}</a>
  </div>
  <p class="card-description">{description}</p>
  <div class="card-meta">
    <time datetime={date.toISOString()}>{formattedDate}</time>
    <div class="tag-list">
      {tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>
  </div>
</article>
